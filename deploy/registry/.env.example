# The registry's public host; its DNS A record must point at this machine.
REGISTRY_HOST=registry.uor.foundation
# kappa-registry at a commit you have read. The build pins it.
KAPPA_COMMIT=main
# Two secrets, 32 bytes of hex each: openssl rand -hex 32
# The gateway's token for kappa-registry (the only writer).
KAPPA_WRITE_TOKEN=
# Signs the short-lived push tokens the gateway issues.
GATEWAY_SECRET=
