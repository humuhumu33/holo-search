# The registry's public name; one DNS A record to this host.
REGISTRY_HOST=registry.uor.foundation
# Owners whose Pages sites are searched for Prism apps every hour; every
# owner that registers an app is added on its own.
DISCOVER_OWNERS=UOR-Foundation,afflom,humuhumu33
# Optional: a GitHub token (no scopes) raises the star refresh from hourly to
# every ten minutes and the discovery rate limit from 60 to 5000 an hour.
GITHUB_TOKEN=
# The hub's network and services, as named on this host.
EDGE_NETWORK=twenty_default
KAPPA_URL=http://hub-kappa:5000
ARTIFACTS_URL=http://hub-registry:5000
ARTIFACTS_HOST=hub.uor.foundation
