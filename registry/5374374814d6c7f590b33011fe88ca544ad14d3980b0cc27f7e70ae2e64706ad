definition{
  name: member,
  parameters: [key : String, keys : (List String)],
  result: Bool,
  body: (match keys
    | List.nil => false
    | List.cons head rest => (if (prim equal key head : Bool) then true else (member key rest))),
  executable: true,
  recursive_argument: keys
}

definition{
  name: distinct,
  parameters: [keys : (List String)],
  result: Bool,
  body: (match keys
    | List.nil => true
    | List.cons head rest => (if (member head rest) then false else (distinct rest))),
  executable: true,
  recursive_argument: keys
}

definition{
  name: allMembers,
