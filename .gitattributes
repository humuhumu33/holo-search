# Content-addressed bytes: a model's address is the SHA-256 (or BLAKE3) of its
# exact bytes, so git must never rewrite their line endings.
registry/** -text
src/*.lex.tex -text
index.html -text
# The Prism frame and the brand are pinned byte for byte by frame.lock and
# brand.lock, and the page is built from them: no line ending is converted.
bootstrap/** -text
site/** -text
frame.lock -text
brand.lock -text
lighthouserc.json -text
